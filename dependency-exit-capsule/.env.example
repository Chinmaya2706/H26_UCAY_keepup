# Dependency Exit Capsule — Environment Configuration

# Gemma 4 API Configuration
# Supported providers: OpenRouter, Groq, Google AI Studio, or any OpenAI-compatible inference endpoint (e.g., local Ollama / vLLM).
# If unconfigured, the application runs in deterministic mode without AI recommendations.

GEMMA_API_KEY=your_gemma_api_key_here
GEMMA_MODEL=gemma-4-it
GEMMA_BASE_URL=https://openrouter.ai/api/v1

# Example for Google AI Studio:
# GEMMA_BASE_URL=https://generativelanguage.googleapis.com
# GEMMA_MODEL=gemini-2.5-flash
# GEMMA_API_KEY=your_gemini_api_key

# Example for local Ollama / vLLM:
# GEMMA_BASE_URL=http://localhost:11434/v1
# GEMMA_MODEL=gemma2:9b
# GEMMA_API_KEY=ollama
